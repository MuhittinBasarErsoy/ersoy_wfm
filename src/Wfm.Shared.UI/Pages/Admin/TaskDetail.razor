@page "/tasks/{Id:guid}"
@implements IDisposable
@inject WfmApiClient Api
@inject WfmRealtime Realtime
@inject UserContext Me
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@inject WfmJs Js

@if (_task is null)
{
    <PageTitle>Görev · WFM</PageTitle>
    @if (_notFound)
    {
        <EmptyState Icon="@Icons.Material.Outlined.SearchOff" Title="Görev bulunamadı" Text="Silinmiş olabilir ya da bu görevi görme yetkiniz yok.">
            <MudButton Href="/tasks" Variant="Variant.Outlined">Görevlere dön</MudButton>
        </EmptyState>
    }
    else
    {
        <MudProgressLinear Indeterminate />
    }
}
else
{
    var t = _task;
    <PageHeader Title="@t.Title" BackHref="/tasks" BackLabel="Görevlere dön">
        <Leading><TypeIcon Icon="@t.TaskTypeIcon" Color="@t.TaskTypeColor" Title="@t.TaskTypeName" /></Leading>
        <SubtitleContent>@t.TaskTypeName · oluşturuldu @Ui.Local(t.CreatedAt)</SubtitleContent>
        <Badges>
            <div class="d-flex align-center gap-2 flex-wrap">
                <StatusChip Status="t.Status" />
                <PriorityLabel Priority="t.Priority" />
                <OverdueBadge Task="t" />
            </div>
        </Badges>
        <Actions>
            @if (Me.Can(Policies.ManageTasks))
            {
                @if (IsOpen)
                {
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Share" OnClick="ShareTrackingAsync">Müşteri takip linki</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Edit" OnClick="EditAsync">Düzenle</MudButton>
                }
                <MudMenu Icon="@Icons.Material.Filled.MoreVert" AriaLabel="Diğer işlemler" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                    <MudMenuItem OnClick="PrintAsync" Icon="@Icons.Material.Filled.Print">Yazdır / PDF</MudMenuItem>
                    @if (IsOpen)
                    {
                        <MudMenuItem OnClick="CancelTaskAsync" Icon="@Icons.Material.Filled.Cancel" IconColor="Color.Error">Görevi iptal et</MudMenuItem>
                    }
                    @if (t.Status is WorkTaskStatus.Draft or WorkTaskStatus.Cancelled)
                    {
                        <MudMenuItem OnClick="DeleteAsync" Icon="@Icons.Material.Filled.Delete" IconColor="Color.Error">Kalıcı olarak sil</MudMenuItem>
                    }
                </MudMenu>
            }
        </Actions>
    </PageHeader>

    @if (t.Status is WorkTaskStatus.Draft or WorkTaskStatus.Rejected && Me.Can(Policies.ManageTasks))
    {
        <MudAlert Severity="Severity.Warning" Class="mb-3" Dense>
            @(t.Status == WorkTaskStatus.Rejected ? "Görev çalışan tarafından reddedildi. Başka bir çalışana atayın." : "Görev henüz kimseye atanmadı.")
        </MudAlert>
    }

    <MudGrid Spacing="3">
        <MudItem xs="12" md="7">
            <MudPaper Elevation="1" Class="pa-4 mb-3">
                <MudGrid Spacing="2">
                    <MudItem xs="12" sm="6">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Atanan çalışan</MudText>
                        @if (Me.Can(Policies.ManageTasks) && IsOpen)
                        {
                            <MudSelect T="Guid?" Value="t.AssigneeId" ValueChanged="AssignAsync" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable Placeholder="Atanmadı"
                                       aria-label="Atanan çalışan">
                                @foreach (var w in _workers.Where(w => w.IsActive))
                                {
                                    <MudSelectItem T="Guid?" Value="w.Id">@w.FullName</MudSelectItem>
                                }
                            </MudSelect>
                        }
                        else
                        {
                            <MudText>@(t.AssigneeName ?? "—")</MudText>
                        }
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Planlanan</MudText>
                        <MudText>@Ui.Local(t.ScheduledStart)@(t.ScheduledEnd is null ? "" : " – " + Ui.Local(t.ScheduledEnd, "HH:mm"))</MudText>
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Müşteri</MudText>
                        <MudText>
                            @(t.CustomerName ?? "—")
                            @if (t.CustomerPhone is not null)
                            {
                                <span> · <a href="tel:@t.CustomerPhone" style="color:var(--mud-palette-primary)">@t.CustomerPhone</a></span>
                            }
                        </MudText>
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Yola çıkış / tamamlanma</MudText>
                        <MudText>
                            @Ui.Local(t.StartedAt) / @Ui.Local(t.CompletedAt)
                            @if (t.StartedAt is { } st && t.CompletedAt is { } ct)
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary" Style="display:block">Süre: @Ui.Duration(ct - st)</MudText>
                            }
                        </MudText>
                    </MudItem>
                    <MudItem xs="12">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Adres</MudText>
                        <MudText>@t.Address</MudText>
                    </MudItem>
                    @if (!string.IsNullOrWhiteSpace(t.Description))
                    {
                        <MudItem xs="12">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Açıklama</MudText>
                            <MudText Style="white-space:pre-wrap">@t.Description</MudText>
                        </MudItem>
                    }
                    @if (!string.IsNullOrWhiteSpace(t.CompletionNote))
                    {
                        <MudItem xs="12">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Saha notu</MudText>
                            <MudText Style="white-space:pre-wrap">@t.CompletionNote</MudText>
                        </MudItem>
                    }
                </MudGrid>
            </MudPaper>

            @if (t.TaskType is { } type && type.Fields.Count > 0)
            {
                <MudPaper Elevation="1" Class="pa-4 mb-3">
                    <MudText Typo="Typo.subtitle1" Class="mb-2"><b>@type.Name bilgileri</b></MudText>
                    <MudGrid Spacing="1">
                        <MudItem xs="12" sm="6"><DynamicFieldForm Fields="type.Fields.Where(f => !f.FilledOnCompletion)" Values="t.CustomFieldValues" ReadOnly /></MudItem>
                        <MudItem xs="12" sm="6">
                            @if (type.Fields.Any(f => f.FilledOnCompletion))
                            {
                                <MudText Typo="Typo.caption" Color="Color.Primary" Class="mb-1">Sahada doldurulan</MudText>
                                <DynamicFieldForm Fields="type.Fields.Where(f => f.FilledOnCompletion)" Values="t.CustomFieldValues" ReadOnly />
                            }
                        </MudItem>
                    </MudGrid>
                </MudPaper>
            }

            <MudPaper Elevation="1" Class="pa-4 mb-3">
                <MudText Typo="Typo.subtitle1" Class="mb-2"><b>Fotoğraflar ve imza</b></MudText>
                <AttachmentGallery Attachments="t.Attachments" Empty="Henüz kanıt yüklenmedi." />
            </MudPaper>

            <MudPaper Elevation="1" Class="pa-4 mb-3 wfm-no-print">
                <MudText Typo="Typo.subtitle1" Class="mb-2"><b>Çalışanla mesajlaşma</b></MudText>
                <CommentThread TaskId="t.Id" CanPost="@(Me.Can(Policies.ManageTasks) && t.AssigneeId is not null)"
                               Empty="@(t.AssigneeId is null ? "Görev atandığında çalışanla buradan yazışabilirsiniz." : "Henüz mesaj yok. Çalışana not ya da soru gönderebilirsiniz.")" />
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="5">
            <MudPaper Elevation="1" Class="pa-2 mb-3">
                <div style="height:320px">
                    <LeafletMap @ref="_map" Height="100%" Latitude="t.Latitude" Longitude="t.Longitude" Zoom="15" OnReady="DrawMapAsync" />
                </div>
                <div class="wfm-legend">
                    <span><i style="background:@Ui.StatusHex(t.Status)"></i>Görev konumu</span>
                    <span><i style="background:@MapMarker.WorkerOnShift"></i>Çalışanın son konumu</span>
                    <span>• Durum değişikliğinin yapıldığı yer</span>
                </div>
            </MudPaper>
            <MudPaper Elevation="1" Class="pa-4">
                <MudText Typo="Typo.subtitle1" Class="mb-3"><b>Görev geçmişi</b></MudText>
                <TaskTimeline Events="t.Events" />
            </MudPaper>
        </MudItem>
    </MudGrid>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private WorkTaskDetailDto? _task;
    private List<UserDto> _workers = [];
    private List<TaskTypeDto> _types = [];
    private LeafletMap? _map;
    private bool _notFound;

    private bool IsOpen => _task is not null && !Ui.IsClosed(_task.Status);

    protected override async Task OnInitializedAsync()
    {
        Realtime.TaskChanged += OnTaskChanged;
        Realtime.LocationUpdated += OnLocation;
        if (Me.Can(Policies.ManageTasks))
        {
            _workers = await Api.GetUsersAsync(Roles.FieldWorker);
            _types = await Api.GetTaskTypesAsync(includeInactive: true);
        }
    }

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            _task = await Api.GetTaskAsync(Id);
            _notFound = false;
            if (_map is not null) await DrawMapAsync();
        }
        catch (ApiException ex) when (ex.Status is System.Net.HttpStatusCode.NotFound or System.Net.HttpStatusCode.Forbidden)
        {
            _notFound = true;
        }
    }

    private async Task DrawMapAsync()
    {
        if (_map is null || _task is null) return;
        await _map.SetMarkersAsync("task", [MapMarker.ForTask(_task)]);
        // Çalışanın son konumu ve tamamlama/ilerleme noktaları
        var evPoints = _task.Events.Where(e => e.Latitude is not null)
            .Select(e => new MapMarker(e.Id.ToString(), e.Latitude!.Value, e.Longitude!.Value, Ui.StatusHex(e.ToStatus), "•",
                Popup: $"{MapMarker.E(Ui.Status(e.ToStatus))} · {MapMarker.E(Ui.Local(e.CreatedAt))}"));
        await _map.SetMarkersAsync("events", evPoints);
        if (_task.AssigneeId is { } a && IsOpen && Me.Can(Policies.ViewTracking))
        {
            var live = (await Api.GetLiveLocationsAsync()).FirstOrDefault(w => w.UserId == a);
            if (live is not null) await _map.SetMarkersAsync("worker", [MapMarker.ForWorker(live)]);
        }
        await _map.FitAllAsync();
    }

    private async Task AssignAsync(Guid? assignee)
    {
        if (_task is null || assignee == _task.AssigneeId) return;
        var name = _workers.FirstOrDefault(w => w.Id == assignee)?.FullName;
        var inProgress = _task.Status is WorkTaskStatus.Accepted or WorkTaskStatus.EnRoute or WorkTaskStatus.OnSite;
        var message = assignee is null
            ? $"Görev {_task.AssigneeName} adlı çalışandan geri alınacak ve taslağa dönecek."
            : _task.AssigneeId is null
                ? $"Görev {name} adlı çalışana atanacak ve bildirim gönderilecek."
                : $"Görev {_task.AssigneeName} yerine {name} adlı çalışana atanacak. İki çalışana da bildirim gider." +
                  (inProgress ? " Görev şu an yürütülüyor; akış baştan başlayacak." : "");
        if (await Dialogs.ShowMessageBoxAsync(assignee is null ? "Atamayı kaldır" : "Atamayı değiştir", message,
                assignee is null ? "Kaldır" : "Ata", cancelText: "Vazgeç") != true)
        {
            StateHasChanged(); // seçimi eski değere döndür
            return;
        }
        try
        {
            await Api.AssignTaskAsync(Id, assignee);
            Snackbar.Add(assignee is null ? "Atama kaldırıldı." : "Görev atandı, çalışana bildirim gönderildi.", Severity.Success);
            await LoadAsync();
        }
        catch (ApiException ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private async Task EditAsync()
    {
        var tenant = await Api.MyTenantAsync();
        var parameters = new DialogParameters<TaskEditDialog>
        {
            { x => x.Existing, _task },
            { x => x.Types, _types.Where(x => x.IsActive || x.Id == _task?.TaskTypeId).ToList() },
            { x => x.Workers, _workers },
            { x => x.Center, new GeoPoint(tenant.DefaultLatitude, tenant.DefaultLongitude) }
        };
        var dialog = await Dialogs.ShowAsync<TaskEditDialog>(null, parameters, TaskEditDialog.Options);
        if (await dialog.Result is { Canceled: false }) await LoadAsync();
    }

    private async Task ShareTrackingAsync()
    {
        try
        {
            var link = await Api.CreateTrackingLinkAsync(Id);
            var url = $"{await Js.Invoke<string>("origin")}/track/{link.Token}";
            var text = $"{_task?.Title} görevinizi buradan takip edebilirsiniz";
            if (await Js.Invoke<bool>("shareLink", _task?.Title ?? "Görev takibi", text, url)) return;
            await Js.Invoke<bool>("copyText", url);
            Snackbar.Add("Takip linki panoya kopyalandı. Müşteriye SMS ya da mesajla gönderebilirsiniz.", Severity.Success, o =>
            {
                o.Action = "Aç";
                o.OnClick = _ => Js.Run("openUrl", url).AsTask();
            });
            await LoadAsync();
        }
        catch (ApiException ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private Task PrintAsync() => Js.Run("print").AsTask();

    private async Task CancelTaskAsync()
    {
        var note = await Prompt.AskAsync(Dialogs, "Görevi iptal et", "İptal nedeni (çalışan görecek)", "ör. Müşteri talebi ertelendi");
        if (note is null) return;
        try
        {
            await Api.ChangeStatusAsync(Id, new ChangeStatusRequest { Status = WorkTaskStatus.Cancelled, Note = note });
            Snackbar.Add("Görev iptal edildi.", Severity.Success);
            await LoadAsync();
        }
        catch (ApiException ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private async Task DeleteAsync()
    {
        if (await Dialogs.ShowMessageBoxAsync("Görevi kalıcı olarak sil", "Görev, geçmişi ve tüm ekleri silinecek. Bu işlem geri alınamaz.", "Sil", cancelText: "Vazgeç") != true) return;
        try
        {
            await Api.DeleteTaskAsync(Id);
            Snackbar.Add("Görev silindi.", Severity.Success);
            Nav.NavigateTo("/tasks");
        }
        catch (ApiException ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private void OnTaskChanged(WorkTaskDto t)
    {
        if (t.Id == Id) _ = InvokeAsync(async () => { await LoadAsync(); StateHasChanged(); });
    }

    private void OnLocation(WorkerLocationDto w)
    {
        if (_task?.AssigneeId == w.UserId && _map is not null)
            _ = InvokeAsync(() => _map.UpsertMarkerAsync("worker", MapMarker.ForWorker(w)).AsTask());
    }

    public void Dispose()
    {
        Realtime.TaskChanged -= OnTaskChanged;
        Realtime.LocationUpdated -= OnLocation;
    }
}
