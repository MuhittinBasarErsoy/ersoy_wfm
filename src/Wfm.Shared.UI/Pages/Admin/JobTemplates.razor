@page "/job-templates"
@inject WfmApiClient Api
@inject NavigationManager Nav

<RequirePolicy Policy="@Policies.ManageTasks">
    <PageHeader Title="İş şablonları" Subtitle="Birden fazla kişinin sırayla (veya aynı anda) yaptığı işleri bir kez tanımlayın, her seferinde tek tıkla başlatın.">
        <Actions>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Href="/job-templates/new">Yeni şablon</MudButton>
        </Actions>
    </PageHeader>

    @if (_templates is null)
    {
        <MudProgressLinear Indeterminate />
    }
    else if (_templates.Count == 0)
    {
        <EmptyState Icon="@Icons.Material.Outlined.AccountTree" Title="Henüz şablon yok"
                    Text="Ör. 'Evrak gönderimi': önce fotokopi çekilir, sonra postaneye götürülür, en son mail atılır.">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/job-templates/new">İlk şablonu oluştur</MudButton>
        </EmptyState>
    }
    else
    {
        <MudGrid Spacing="3">
            @foreach (var t in _templates)
            {
                <MudItem xs="12" md="6">
                    <MudCard Elevation="1" Style="height:100%">
                        <MudCardContent>
                            <div class="d-flex align-center gap-2 mb-1">
                                <MudIcon Icon="@Icons.Material.Filled.AccountTree" Color="Color.Primary" aria-hidden="true" />
                                <MudText Typo="Typo.h6" Style="flex:1">@t.Name</MudText>
                                <MudChip T="string" Size="Size.Small">@t.Steps.Count adım</MudChip>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(t.Description))
                            {
                                <MudText Typo="Typo.body2" Class="mb-2">@t.Description</MudText>
                            }
                            <JobFlowSummary Steps="t.Steps" Workers="_workers" />
                        </MudCardContent>
                        <MudCardActions>
                            <MudButton StartIcon="@Icons.Material.Filled.Edit" Href="@($"/job-templates/{t.Id}")">Düzenle</MudButton>
                            <MudSpacer />
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PlayArrow"
                                       Href="@($"/jobs/new?template={t.Id}")">İş başlat</MudButton>
                        </MudCardActions>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>
    }
</RequirePolicy>

@code {
    private List<JobTemplateDto>? _templates;
    private List<UserDto> _workers = [];

    protected override async Task OnInitializedAsync()
    {
        var workers = Api.GetUsersAsync(Roles.FieldWorker);
        _templates = await Api.GetJobTemplatesAsync();
        _workers = await workers;
    }
}
