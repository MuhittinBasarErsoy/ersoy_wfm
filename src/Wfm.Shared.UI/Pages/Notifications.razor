@page "/notifications"
@implements IDisposable
@inject NotificationCenter Center
@inject UserContext Me
@inject NavigationManager Nav

@if (Me.IsFieldWorker)
{
    <AppTitle Title="Bildirimler" />
}
else
{
    <PageHeader Title="Bildirimler" Subtitle="@(Center.Unread > 0 ? $"{Center.Unread} okunmamış" : "Hepsi okundu")" />
}

<div class="d-flex align-center flex-wrap gap-2 mb-3">
    <MudChipSet T="string" @bind-SelectedValue="_filter" SelectionMode="SelectionMode.SingleSelection" CheckMark Size="Size.Small">
        <MudChip T="string" Value="@("all")" Default>Tümü</MudChip>
        <MudChip T="string" Value="@("unread")">Okunmamış (@Center.Unread)</MudChip>
    </MudChipSet>
    <MudSpacer />
    @if (Center.Unread > 0)
    {
        <MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.DoneAll" OnClick="Center.MarkAllReadAsync">Tümünü okundu say</MudButton>
    }
</div>

@if (Visible.Count == 0)
{
    <EmptyState Icon="@Icons.Material.Outlined.NotificationsNone" Title="@(_filter == "unread" ? "Okunmamış bildirim yok" : "Bildirim yok")"
                Text="Görev atamaları, iptaller, gecikmeler ve mesajlar burada görünür." />
}
@foreach (var group in Visible.GroupBy(n => Ui.DayLabel(n.CreatedAt)))
{
    <MudText Typo="Typo.overline" Color="Color.Secondary" Class="d-block mt-2">@group.Key</MudText>
    @foreach (var n in group)
    {
        var unread = n.ReadAt is null;
        <Tap Class="mb-2" OnClick="@(() => OpenAsync(n))" AriaLabel="@($"{(unread ? "Okunmamış: " : "")}{n.Title}. {n.Body}")">
            <MudPaper Elevation="@(unread ? 2 : 0)" Outlined="!unread" Class="pa-3"
                      Style="@(unread ? "box-shadow:inset 3px 0 0 var(--mud-palette-primary)" : null)">
                <div class="d-flex align-center gap-3">
                    <MudIcon Icon="@Ui.NotificationIcon(n.Kind)" Color="@(unread ? Ui.NotificationColor(n.Kind) : Color.Default)" aria-hidden="true" />
                    <div style="flex:1;min-width:0">
                        <MudText Typo="Typo.body1">@if (unread) { <b>@n.Title</b> } else { @n.Title }</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">@n.Body</MudText>
                    </div>
                    <div class="d-flex flex-column align-end">
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Style="white-space:nowrap">@Ui.Local(n.CreatedAt, "HH:mm")</MudText>
                        @if (n.WorkTaskId is not null)
                        {
                            <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" Color="Color.Secondary" aria-hidden="true" />
                        }
                    </div>
                </div>
            </MudPaper>
        </Tap>
    }
}

@code {
    private string? _filter = "all";

    private List<NotificationDto> Visible => Center.Items.Where(n => _filter != "unread" || n.ReadAt is null).ToList();

    protected override async Task OnInitializedAsync()
    {
        Center.Changed += Refresh;
        await Center.RefreshAsync();
    }

    private async Task OpenAsync(NotificationDto n)
    {
        await Center.MarkReadAsync(n.Id);
        if (n.WorkTaskId is { } id) Nav.NavigateTo(Me.IsFieldWorker ? $"/field/tasks/{id}" : $"/tasks/{id}");
        else if (n.Kind == NotificationKinds.PasswordReset && Me.Can(Policies.ManageUsers))
        {
            // Gövde "Ad Soyad (e-posta) ..." biçiminde; kullanıcıyı listede bulup açmak için e-postayı al.
            var m = System.Text.RegularExpressions.Regex.Match(n.Body, @"\(([^)]+@[^)]+)\)");
            Nav.NavigateTo(m.Success ? $"/users?q={Uri.EscapeDataString(m.Groups[1].Value)}" : "/users");
        }
    }

    private void Refresh() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Center.Changed -= Refresh;
}
