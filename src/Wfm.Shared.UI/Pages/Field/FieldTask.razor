@page "/field/tasks/{Id:guid}"
@implements IAsyncDisposable
@inject IFieldService Field
@inject IGeolocationService Geo
@inject ICameraService Camera
@inject IExternalActions External
@inject IDialogService Dialogs
@inject ISnackbar Snackbar

<AppTitle Title="@(_task?.Title ?? "Görev")" />

<SyncBanner />

@if (_task is null)
{
    @if (_loaded)
    {
        <EmptyState Icon="@Icons.Material.Outlined.SearchOff" Title="Görev bulunamadı" Text="Görev size atanmış değil ya da geri alınmış olabilir.">
            <MudButton Href="/field" Variant="Variant.Outlined">Görevlerime dön</MudButton>
        </EmptyState>
    }
    else
    {
        <MudProgressLinear Indeterminate />
    }
}
else
{
    var t = _task;
    <div class="d-flex align-center gap-2 mb-2">
        <TypeIcon Icon="@t.TaskTypeIcon" Color="@t.TaskTypeColor" Title="@t.TaskTypeName" />
        <div style="flex:1;min-width:0">
            <h1 class="mud-typography mud-typography-h6" style="line-height:1.2;margin:0" tabindex="-1">@t.Title</h1>
            <MudText Typo="Typo.caption" Color="Color.Secondary">@t.TaskTypeName</MudText>
        </div>
        <StatusChip Status="t.Status" />
    </div>
    <div class="d-flex flex-wrap align-center gap-3 mb-2">
        <StageLabel Stage="@t.Stage" />
        <PriorityLabel Priority="t.Priority" HideNormal />
        <OverdueBadge Task="t" />
    </div>

    <JobContextCard Task="t" />

    @if (Type is { Stages.Count: > 0 } st && TaskStatusFlow.AllowsStage(t.Status))
    {
        <MudPaper Elevation="1" Class="pa-3 mb-3 wfm-stage-picker">
            <MudText Typo="Typo.subtitle2" Class="mb-2" id="stage-label">İş hangi aşamada?</MudText>
            <div class="d-flex flex-wrap gap-2" role="group" aria-labelledby="stage-label">
                @foreach (var stage in st.Stages)
                {
                    var name = stage;
                    var selected = t.Stage == name;
                    <MudButton Variant="@(selected ? Variant.Filled : Variant.Outlined)" Color="Color.Primary" Size="Size.Large"
                               StartIcon="@(selected ? Icons.Material.Filled.Flag : null)" aria-pressed="@(selected ? "true" : "false")"
                               Disabled="_busy" OnClick="@(() => ChangeStageAsync(selected ? null : name))">@name</MudButton>
                }
            </div>
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mt-1">Seçili aşamaya tekrar dokunmak seçimi kaldırır.</MudText>
        </MudPaper>
    }

    @if (!IsDesk && Arrived && t.Status == WorkTaskStatus.EnRoute)
    {
        <MudAlert Severity="Severity.Success" Class="mb-3" Icon="@Icons.Material.Filled.WhereToVote">
            Görev konumuna ulaştınız (@Ui.Distance(_distance!.Value)).
            <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small" Class="ml-2" OnClick="@(() => ChangeAsync(WorkTaskStatus.OnSite))" Disabled="_busy">Vardım</MudButton>
        </MudAlert>
    }

    @if (ShowMap)
    {
        <MudPaper Elevation="1" Class="pa-2 mb-3">
            <div style="height:220px">
                <LeafletMap @ref="_map" Height="100%" Latitude="t.Latitude" Longitude="t.Longitude" Zoom="15" OnReady="DrawMapAsync" />
            </div>
            @if (_distance is { } d)
            {
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="px-1">Görev konumuna uzaklığınız: <b>@Ui.Distance(d)</b></MudText>
            }
        </MudPaper>
    }

    <MudPaper Elevation="1" Class="pa-3 mb-3">
        @if (!string.IsNullOrWhiteSpace(t.Address))
        {
            <div class="d-flex align-start gap-2">
                <MudIcon Icon="@Icons.Material.Filled.Place" Color="Color.Secondary" aria-label="Adres" />
                <MudText Typo="Typo.body1">@t.Address</MudText>
            </div>
        }
        @if (t.CustomerName is not null)
        {
            <div class="d-flex align-center gap-2 mt-1">
                <MudIcon Icon="@Icons.Material.Filled.Person" Color="Color.Secondary" aria-label="Müşteri" />
                <MudText Typo="Typo.body2">@t.CustomerName</MudText>
            </div>
        }
        @if (t.ScheduledStart is not null)
        {
            <div class="d-flex align-center gap-2 mt-1">
                <MudIcon Icon="@Icons.Material.Filled.Schedule" Color="Color.Secondary" aria-label="Planlanan zaman" />
                <MudText Typo="Typo.body2">@Ui.Local(t.ScheduledStart)@(t.ScheduledEnd is null ? "" : " – " + Ui.Local(t.ScheduledEnd, "HH:mm"))</MudText>
            </div>
        }
        <div class="d-flex gap-2 mt-3">
            @if (ShowMap)
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Directions" FullWidth Size="Size.Large"
                           OnClick="@(() => External.OpenDirectionsAsync(t.Latitude, t.Longitude, t.Title))">Yol tarifi</MudButton>
            }
            @if (!string.IsNullOrEmpty(t.CustomerPhone))
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Phone" FullWidth Size="Size.Large"
                           OnClick="@(() => External.CallAsync(t.CustomerPhone))">Müşteriyi ara</MudButton>
            }
        </div>
        @if (!string.IsNullOrWhiteSpace(t.Description))
        {
            <MudText Typo="Typo.body2" Class="mt-3" Style="white-space:pre-wrap">@t.Description</MudText>
        }
        @if (Type is { } type && type.Fields.Any(f => !f.FilledOnCompletion))
        {
            <MudDivider Class="my-3" />
            <DynamicFieldForm Fields="type.Fields.Where(f => !f.FilledOnCompletion)" Values="t.CustomFieldValues" ReadOnly />
        }
    </MudPaper>

    @if ((t.Status == WorkTaskStatus.OnSite || IsDesk && t.Status == WorkTaskStatus.Accepted) && Type is { } ct)
    {
        @* ---------- Tamamlama ---------- *@
        <MudPaper Elevation="1" Class="pa-3 mb-3">
            <MudText Typo="Typo.subtitle1" Class="mb-1"><b>Görevi tamamla</b></MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mb-2">Tamamlamak için gerekenler:</MudText>
            <ul class="wfm-checklist" aria-label="Tamamlama gereksinimleri">
                @foreach (var item in Checklist)
                {
                    <li class="@(item.Done ? "ok" : "todo")">
                        <MudIcon Icon="@(item.Done ? Icons.Material.Filled.CheckCircle : Icons.Material.Outlined.Circle)" Size="Size.Small" aria-hidden="true" />
                        <span>@item.Text</span><span class="sr-only" style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)">@(item.Done ? " tamam" : " eksik")</span>
                    </li>
                }
            </ul>

            @if (ct.Fields.Any(f => f.FilledOnCompletion))
            {
                <DynamicFieldForm Fields="ct.Fields.Where(f => f.FilledOnCompletion)" Values="_completionValues" ValuesChanged="StateHasChanged" ShowErrors="_tried" />
            }

            <MudText Typo="Typo.subtitle2" Class="mt-2">
                Fotoğraflar @(MinPhotos > 0 ? $"(en az {MinPhotos})" : "")
            </MudText>
            <AttachmentGallery Attachments="t.Attachments.Where(a => a.Kind == AttachmentKind.Photo).ToList()" OnRemove="RemoveAttachmentAsync" Empty="Henüz fotoğraf yok." />
            <div class="d-flex gap-2 mt-2 mb-3 flex-wrap">
                @if (Camera.IsSupported)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PhotoCamera" OnClick="TakePhotoAsync" Disabled="_busy" Size="Size.Large">Fotoğraf çek</MudButton>
                }
                <InputFile id="@_fileId" accept="image/*" OnChange="@(e => UploadPhotoAsync(e.File))" hidden />
                <MudButton HtmlTag="label" for="@_fileId" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.AddPhotoAlternate" Disabled="_busy" Size="Size.Large">@(Camera.IsSupported ? "Galeriden" : "Fotoğraf ekle")</MudButton>
            </div>

            @if (ct.Completion.RequireSignature || HasSignature)
            {
                <MudText Typo="Typo.subtitle2" Class="mb-1">Müşteri imzası @(ct.Completion.RequireSignature ? "*" : "")</MudText>
                @if (HasSignature)
                {
                    <AttachmentGallery Attachments="t.Attachments.Where(a => a.Kind == AttachmentKind.Signature).ToList()" OnRemove="RemoveAttachmentAsync" />
                }
                else
                {
                    <SignaturePad @ref="_signature" OnChange="SignatureChanged" />
                }
            }

            <MudTextField T="string" @bind-Value="_note" Label="@(ct.Completion.RequireNote ? "Not *" : "Not (isteğe bağlı)")" Variant="Variant.Outlined" Lines="3" Class="mt-3" Immediate
                          Error="@(_tried && ct.Completion.RequireNote && string.IsNullOrWhiteSpace(_note))" ErrorText="Not zorunlu" />
        </MudPaper>
    }

    @if (t.Status is WorkTaskStatus.Completed or WorkTaskStatus.Failed && Type is { } done)
    {
        <MudPaper Elevation="1" Class="pa-3 mb-3">
            <MudText Typo="Typo.subtitle1" Class="mb-2"><b>@(t.Status == WorkTaskStatus.Completed ? "Teslim kanıtı" : "Yapılamadı")</b> · @Ui.Local(t.CompletedAt)</MudText>
            @if (done.Fields.Any(f => f.FilledOnCompletion))
            {
                <DynamicFieldForm Fields="done.Fields.Where(f => f.FilledOnCompletion)" Values="t.CustomFieldValues" ReadOnly />
            }
            @if (!string.IsNullOrWhiteSpace(t.CompletionNote))
            {
                <MudText Typo="Typo.body2" Class="mb-2" Style="white-space:pre-wrap">@t.CompletionNote</MudText>
            }
            <AttachmentGallery Attachments="t.Attachments" Empty="Kanıt eklenmemiş." />
        </MudPaper>
    }

    @if (Actions.Any())
    {
        <div class="wfm-bottom-actions">
            @if (_errors.Count > 0)
            {
                <MudAlert Severity="Severity.Error" Dense Class="mb-2">@foreach (var e in _errors) { <div>@e</div> }</MudAlert>
            }
            <div class="d-flex flex-wrap gap-2">
                @foreach (var next in Actions)
                {
                    var target = next;
                    var blocked = target == WorkTaskStatus.Completed && !CanComplete;
                    <MudButton Variant="@(IsPrimary(target) ? Variant.Filled : Variant.Outlined)" Color="@ActionColor(target)" Size="Size.Large"
                               Style="@(IsPrimary(target) ? "flex:2;min-width:160px" : "flex:1;min-width:120px")" Disabled="@(_busy || blocked)" OnClick="@(() => ChangeAsync(target))">
                        @if (_busy && IsPrimary(target))
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate Class="mr-2" />
                        }
                        @TaskStatusFlow.ActionName(target)
                    </MudButton>
                }
            </div>
            @if (Actions.Contains(WorkTaskStatus.Completed) && !CanComplete)
            {
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mt-1">Yukarıdaki eksikleri tamamlayınca "Tamamla" etkinleşir.</MudText>
            }
        </div>
    }

    <MudPaper Elevation="0" Outlined Class="pa-3 mt-3">
        <MudText Typo="Typo.subtitle2" Class="mb-2">Dispeçerle mesajlaşma</MudText>
        @if (Field.IsOnline)
        {
            <CommentThread TaskId="t.Id" CanPost="!Ui.IsClosed(t.Status)" Empty="Soru ya da bilgi için dispeçere buradan yazabilirsiniz." />
        }
        else
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary">Mesajlar çevrimdışıyken kullanılamaz.</MudText>
        }
    </MudPaper>

    <MudPaper Elevation="0" Outlined Class="pa-3 mt-3">
        <MudText Typo="Typo.subtitle2" Class="mb-2">Geçmiş</MudText>
        <TaskTimeline Events="t.Events" />
    </MudPaper>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private const double ArrivalMeters = 150;

    private WorkTaskDetailDto? _task;
    private TaskTypeDto? Type;
    private LeafletMap? _map;
    private SignaturePad? _signature;
    private readonly Dictionary<string, string?> _completionValues = [];
    private string? _note;
    private List<string> _errors = [];
    private bool _busy, _loaded, _tried, _signed;
    private double? _distance;
    private PeriodicTimer? _locTimer;
    private readonly CancellationTokenSource _cts = new();
    private readonly string _fileId = "file-" + Guid.NewGuid().ToString("N")[..8];

    private record CheckItem(string Text, bool Done);

    private bool HasSignature => _task?.Attachments.Any(a => a.Kind == AttachmentKind.Signature) == true;
    private int PhotoCount => _task?.Attachments.Count(a => a.Kind == AttachmentKind.Photo) ?? 0;
    private int MinPhotos => Type is null ? 0 : Math.Max(Type.Completion.RequirePhoto ? 1 : 0, Type.Completion.MinPhotoCount);
    private bool Arrived => _distance is { } d && d <= ArrivalMeters;
    /// <summary>Saha ziyareti gerektirmeyen (masa başı) görev: harita, varış ve mesafe kuralı yok.</summary>
    private bool IsDesk => Type is { RequiresVisit: false };
    private bool ShowMap => !IsDesk && _task is { HasLocation: true };

    /// <summary>Görev tipinin tamamlama kurallarının canlı durumu (sunucu da aynı kuralları uygular).</summary>
    private List<CheckItem> Checklist
    {
        get
        {
            var list = new List<CheckItem>();
            if (Type is null) return list;
            var c = Type.Completion;
            foreach (var f in Type.Fields.Where(f => f.FilledOnCompletion && f.Required).OrderBy(f => f.Order))
                list.Add(new($"{f.Label}", f.Type == FieldType.Checkbox ? _completionValues.GetValueOrDefault(f.Key) == "true" : !string.IsNullOrWhiteSpace(_completionValues.GetValueOrDefault(f.Key))));
            if (MinPhotos > 0) list.Add(new($"Fotoğraf: {PhotoCount} / {MinPhotos}", PhotoCount >= MinPhotos));
            if (c.RequireSignature) list.Add(new("Müşteri imzası", HasSignature || _signed));
            if (c.RequireNote) list.Add(new("Tamamlama notu", !string.IsNullOrWhiteSpace(_note)));
            if (c.MaxDistanceMeters > 0 && !IsDesk)
                list.Add(new(_distance is { } d ? $"Görev konumuna en fazla {c.MaxDistanceMeters} m (şu an {Ui.Distance(d)})" : $"Görev konumuna en fazla {c.MaxDistanceMeters} m (konum alınıyor…)",
                    _distance is { } dd && dd <= c.MaxDistanceMeters));
            if (list.Count == 0) list.Add(new("Ek gereksinim yok", true));
            return list;
        }
    }

    private bool CanComplete => Checklist.All(i => i.Done);

    private IEnumerable<WorkTaskStatus> Actions => _task is null ? [] :
        TaskStatusFlow.NextStatuses(_task.Status, !IsDesk).Where(TaskStatusFlow.IsFieldWorkerTransition)
            .OrderBy(s => s is WorkTaskStatus.Rejected or WorkTaskStatus.Failed ? 1 : 0);

    private static bool IsPrimary(WorkTaskStatus s) => s is not (WorkTaskStatus.Rejected or WorkTaskStatus.Failed);
    private static Color ActionColor(WorkTaskStatus s) => s switch
    {
        WorkTaskStatus.Completed => Color.Success,
        WorkTaskStatus.Rejected or WorkTaskStatus.Failed => Color.Error,
        _ => Color.Primary
    };

    protected override async Task OnInitializedAsync()
    {
        Field.Changed += OnChanged;
        await LoadAsync();
        _loaded = true;
        _ = WatchLocationAsync();
    }

    /// <summary>Yolda ve yerindeyken konumu periyodik okuyup varış önerisini ve mesafe kuralını günceller.</summary>
    private async Task WatchLocationAsync()
    {
        await UpdateDistanceAsync();
        _locTimer = new PeriodicTimer(TimeSpan.FromSeconds(20));
        try
        {
            while (await _locTimer.WaitForNextTickAsync(_cts.Token))
                if (_task?.Status is WorkTaskStatus.EnRoute or WorkTaskStatus.OnSite) await UpdateDistanceAsync();
        }
        catch (OperationCanceledException) { }
    }

    private async Task UpdateDistanceAsync()
    {
        if (_task is null || !ShowMap) return;
        if (await Geo.GetCurrentAsync() is not { } me) return;
        var wasArrived = Arrived;
        _distance = Wfm.Domain.Entities.Geo.DistanceMeters(me.Latitude, me.Longitude, _task.Latitude, _task.Longitude);
        if (_map is not null)
            await _map.SetMarkersAsync("me", [new MapMarker("me", me.Latitude, me.Longitude, MapMarker.WorkerOnShift, "Ben", Title: "Konumunuz", Pulse: true)]);
        if (!wasArrived && Arrived && _task.Status == WorkTaskStatus.EnRoute)
            Snackbar.Add("Görev konumuna ulaştınız. 'Vardım' ile durumu güncelleyin.", Severity.Info);
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadAsync()
    {
        _task = await Field.GetTaskAsync(Id);
        if (_task is null) return;
        Type = _task.TaskType ?? await Field.GetTaskTypeAsync(_task.TaskTypeId);
        foreach (var f in Type?.Fields.Where(f => f.FilledOnCompletion) ?? [])
            if (!_completionValues.ContainsKey(f.Key)) _completionValues[f.Key] = _task.CustomFieldValues.GetValueOrDefault(f.Key);
    }

    private async Task DrawMapAsync()
    {
        if (_map is null || _task is null) return;
        await _map.SetMarkersAsync("task", [MapMarker.ForTask(_task)]);
        if (await Geo.GetCurrentAsync() is { } me)
        {
            await _map.SetMarkersAsync("me", [new MapMarker("me", me.Latitude, me.Longitude, MapMarker.WorkerOnShift, "Ben", Title: "Konumunuz", Pulse: true)]);
            await _map.FitAllAsync();
        }
    }

    private void SignatureChanged(bool hasInk) => _signed = hasInk;

    private async Task ChangeAsync(WorkTaskStatus target)
    {
        if (_task is null) return;
        _errors.Clear();
        string? note = null;

        if (target is WorkTaskStatus.Rejected or WorkTaskStatus.Failed)
        {
            note = await AskReasonAsync(target == WorkTaskStatus.Rejected ? "Görevi reddet" : "Görev yapılamadı");
            if (note is null) return;
        }
        if (target == WorkTaskStatus.Completed)
        {
            _tried = true;
            if (!CanComplete) return;
            if (await Dialogs.ShowMessageBoxAsync("Görevi tamamla", "Görev tamamlandı olarak işaretlenecek ve kanıtlar gönderilecek. Bu işlem geri alınamaz.",
                    "Tamamla", cancelText: "Vazgeç") != true) return;
        }

        _busy = true;
        try
        {
            var location = await Geo.GetCurrentAsync();
            if (target == WorkTaskStatus.Completed)
            {
                if (!await PrepareCompletionAsync(location)) return;
                note = _note;
            }

            await Field.ChangeStatusAsync(_task.Id, new ChangeStatusRequest
            {
                Status = target,
                Note = note,
                Latitude = location?.Latitude,
                Longitude = location?.Longitude,
                CustomFieldValues = target == WorkTaskStatus.Completed ? new(_completionValues) : null,
                ClientTimestamp = DateTime.UtcNow
            });
            Snackbar.Add(Field.IsOnline ? $"{TaskStatusFlow.DisplayName(target)} olarak işaretlendi." : "Kaydedildi; bağlantı gelince gönderilecek.",
                Field.IsOnline ? Severity.Success : Severity.Info);
            await LoadAsync();
            if (_map is not null && _task is not null) await _map.SetMarkersAsync("task", [MapMarker.ForTask(_task)]);
        }
        catch (ApiException ex)
        {
            _errors.Add(ex.Message);
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ChangeStageAsync(string? stage)
    {
        if (_task is null) return;
        _busy = true;
        try
        {
            await Field.ChangeStageAsync(_task.Id, new ChangeStageRequest(stage, ClientTimestamp: DateTime.UtcNow));
            Snackbar.Add(!Field.IsOnline ? "Kaydedildi; bağlantı gelince gönderilecek."
                    : stage is null ? "Aşama kaldırıldı." : $"Aşama: {stage}",
                Field.IsOnline ? Severity.Success : Severity.Info);
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>İmzayı yükler ve görev tipinin tamamlama kurallarını cihazda doğrular (offline'da da çalışsın diye).</summary>
    private async Task<bool> PrepareCompletionAsync(GeoPoint? location)
    {
        if (_task is null || Type is null) return false;

        if (!HasSignature && _signature is not null && await _signature.GetPngAsync() is { } png)
        {
            await Field.AddAttachmentAsync(_task.Id, new CapturedFile(png, "imza.png", "image/png"), AttachmentKind.Signature, location);
            await LoadAsync();
        }

        double? distance = location is null ? null : Wfm.Domain.Entities.Geo.DistanceMeters(location.Latitude, location.Longitude, _task.Latitude, _task.Longitude);
        _errors = TaskRules.ValidateCompletion(new TaskType { Fields = Type.Fields, Completion = Type.Completion, RequiresVisit = Type.RequiresVisit }, _completionValues,
            PhotoCount, HasSignature, _note, distance);
        return _errors.Count == 0;
    }

    private async Task<string?> AskReasonAsync(string title)
    {
        var parameters = new DialogParameters<ReasonDialog> { { x => x.Title, title } };
        var dialog = await Dialogs.ShowAsync<ReasonDialog>(title, parameters, new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Small });
        var result = await dialog.Result;
        return result is { Canceled: false, Data: string s } ? s : null;
    }

    private async Task TakePhotoAsync()
    {
        if (_task is null) return;
        try
        {
            if (await Camera.CapturePhotoAsync() is not { } photo) return;
            _busy = true;
            await Field.AddAttachmentAsync(_task.Id, photo, AttachmentKind.Photo, await Geo.GetCurrentAsync());
            await LoadAsync();
        }
        catch (Exception ex) when (ex is ApiException or InvalidOperationException)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task UploadPhotoAsync(IBrowserFile? file)
    {
        if (file is null || _task is null) return;
        if (file.Size > 10 * 1024 * 1024)
        {
            Snackbar.Add("Fotoğraf 10 MB'tan büyük olamaz.", Severity.Warning);
            return;
        }
        _busy = true;
        try
        {
            using var ms = new MemoryStream();
            await file.OpenReadStream(10 * 1024 * 1024).CopyToAsync(ms);
            await Field.AddAttachmentAsync(_task.Id, new CapturedFile(ms.ToArray(), file.Name, file.ContentType), AttachmentKind.Photo, await Geo.GetCurrentAsync());
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RemoveAttachmentAsync(AttachmentDto a)
    {
        if (_task is null) return;
        try
        {
            await Field.RemoveAttachmentAsync(_task.Id, a.Id);
            if (a.Kind == AttachmentKind.Signature) _signed = false;
            await LoadAsync();
        }
        catch (ApiException ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private void OnChanged() => _ = InvokeAsync(async () =>
    {
        if (_busy) return;
        await LoadAsync();
        StateHasChanged();
    });

    public ValueTask DisposeAsync()
    {
        Field.Changed -= OnChanged;
        _cts.Cancel();
        _locTimer?.Dispose();
        _cts.Dispose();
        return ValueTask.CompletedTask;
    }
}
