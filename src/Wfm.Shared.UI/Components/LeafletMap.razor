@implements IAsyncDisposable
@inject WfmJs Js

@* OpenStreetMap + Leaflet harita bileşeni. Leaflet host sayfada (index.html / App.razor) yüklenir. *@
<div id="@_id" class="wfm-map @Class" style="height:@Height"></div>

@code {
    private readonly string _id = "map-" + Guid.NewGuid().ToString("N")[..8];
    private DotNetObjectReference<LeafletMap>? _ref;
    private bool _ready;

    [Parameter] public double Latitude { get; set; } = 41.0082;
    [Parameter] public double Longitude { get; set; } = 28.9784;
    [Parameter] public int Zoom { get; set; } = 12;
    [Parameter] public string Height { get; set; } = "400px";
    [Parameter] public string? Class { get; set; }
    [Parameter] public bool Clickable { get; set; }
    [Parameter] public EventCallback<GeoPoint> OnMapClick { get; set; }
    [Parameter] public EventCallback<MarkerClick> OnMarkerClick { get; set; }
    /// <summary>Harita oluşturulduğunda; işaretçiler bu noktadan sonra eklenebilir.</summary>
    [Parameter] public EventCallback OnReady { get; set; }

    public bool IsReady => _ready;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _ref = DotNetObjectReference.Create(this);
        _ready = await Js.Invoke<bool>("createMap", _id, Latitude, Longitude, Zoom, _ref, Clickable);
        if (_ready) await OnReady.InvokeAsync();
    }

    public ValueTask SetMarkersAsync(string layer, IEnumerable<MapMarker> markers) =>
        _ready ? Js.Run("setMarkers", _id, layer, markers.ToArray()) : ValueTask.CompletedTask;

    public ValueTask UpsertMarkerAsync(string layer, MapMarker marker) =>
        _ready ? Js.Run("upsertMarker", _id, layer, marker) : ValueTask.CompletedTask;

    public ValueTask SetPolylineAsync(string name, IEnumerable<GeoPoint> points, string color = "#1565c0") =>
        _ready ? Js.Run("setPolyline", _id, name, points.Select(p => new { lat = p.Latitude, lng = p.Longitude }).ToArray(), color) : ValueTask.CompletedTask;

    public ValueTask SetPickAsync(double lat, double lng) => _ready ? Js.Run("setPick", _id, lat, lng) : ValueTask.CompletedTask;
    public ValueTask SetViewAsync(double lat, double lng, int zoom) => _ready ? Js.Run("setView", _id, lat, lng, zoom) : ValueTask.CompletedTask;
    public ValueTask FitAllAsync() => _ready ? Js.Run("fitAll", _id) : ValueTask.CompletedTask;
    public ValueTask OpenPopupAsync(string layer, string id) => _ready ? Js.Run("openPopup", _id, layer, id) : ValueTask.CompletedTask;

    [JSInvokable("OnMapClick")]
    public Task HandleMapClick(double lat, double lng) => OnMapClick.InvokeAsync(new GeoPoint(lat, lng));

    [JSInvokable("OnMarkerClick")]
    public Task HandleMarkerClick(string layer, string id) => OnMarkerClick.InvokeAsync(new MarkerClick(layer, id));

    public async ValueTask DisposeAsync()
    {
        if (_ready) await Js.Run("disposeMap", _id);
        _ref?.Dispose();
    }
}
