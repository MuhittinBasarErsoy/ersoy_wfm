@inject UserContext Me

@* Sayfa içeriğini rol politikasına göre gösterir. API de aynı kontrolü yapar; bu yalnızca UI tarafıdır. *@
@if (Me.Can(Policy))
{
    @ChildContent
}
else
{
    <PageTitle>Yetki yok · WFM</PageTitle>
    <EmptyState Icon="@Icons.Material.Outlined.Lock" Title="Bu sayfayı görüntüleme yetkiniz yok"
                Text="@($"Rolünüz: {Me.RoleName}. Erişim gerekiyorsa şirket yöneticinize başvurun.")" Class="mt-6">
        <MudButton Href="/" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Home">Ana sayfaya dön</MudButton>
    </EmptyState>
}

@code {
    [Parameter, EditorRequired] public string Policy { get; set; } = "";
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
