<span class="wfm-type-icon" style="background:@Color" title="@Title" role="@(Title is null ? null : "img")" aria-label="@Title" aria-hidden="@(Title is null ? "true" : null)"><span class="material-icons" aria-hidden="true">@Icon</span></span>

@code {
    [Parameter] public string Icon { get; set; } = "assignment";
    [Parameter] public string Color { get; set; } = "#1976d2";
    [Parameter] public string? Title { get; set; }
}
