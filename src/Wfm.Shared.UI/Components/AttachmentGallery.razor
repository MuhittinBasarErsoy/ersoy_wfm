@inject WfmApiClient Api
@inject IDialogService Dialogs

@if (Attachments.Count == 0)
{
    <MudText Typo="Typo.body2" Color="Color.Secondary">@Empty</MudText>
}
else
{
    <div class="wfm-thumbs">
        @for (var i = 0; i < Attachments.Count; i++)
        {
            var a = Attachments[i];
            var signature = a.Kind == AttachmentKind.Signature;
            var label = signature ? "İmzayı büyüt" : $"Fotoğraf {i + 1} büyüt";
            <div class="wfm-thumb-wrap">
                @if (a.ContentType.StartsWith("image/"))
                {
                    <button type="button" class="@(signature ? "wfm-thumb wfm-thumb-signature" : "wfm-thumb")" @onclick="@(() => OpenAsync(a))" aria-label="@label">
                        <img src="@Src(a)" alt="" loading="lazy" />
                        <span class="wfm-thumb-badge">@(signature ? "İmza" : Ui.Local(a.CapturedAt, "HH:mm"))</span>
                    </button>
                }
                else
                {
                    <a href="@Src(a)" target="_blank" rel="noopener" class="wfm-thumb d-flex align-center justify-center" aria-label="@a.FileName">
                        <MudIcon Icon="@Icons.Material.Filled.Description" />
                    </a>
                }
                @if (OnRemove.HasDelegate)
                {
                    <MudIconButton Class="wfm-thumb-remove" Icon="@Icons.Material.Filled.Close" Size="Size.Small" Color="Color.Error"
                                   OnClick="@(() => RemoveAsync(a))" aria-label="@(signature ? "İmzayı kaldır" : "Fotoğrafı kaldır")" />
                }
            </div>
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public List<AttachmentDto> Attachments { get; set; } = [];
    [Parameter] public EventCallback<AttachmentDto> OnRemove { get; set; }
    [Parameter] public string Empty { get; set; } = "Ek yok.";

    // Offline eklenen dosyalar data: URL'idir; sunucudakiler göreli imzalı URL.
    private string Src(AttachmentDto a) => a.Url.StartsWith("data:") ? a.Url : Api.AbsoluteUrl(a.Url);

    private async Task OpenAsync(AttachmentDto a)
    {
        var images = Attachments.Where(x => x.ContentType.StartsWith("image/")).ToList();
        var parameters = new DialogParameters<ImageViewer>
        {
            { x => x.Items, images },
            { x => x.Index, images.IndexOf(a) },
            { x => x.Src, Src }
        };
        await Dialogs.ShowAsync<ImageViewer>(null, parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseOnEscapeKey = true, CloseButton = true });
    }

    private async Task RemoveAsync(AttachmentDto a)
    {
        var what = a.Kind == AttachmentKind.Signature ? "İmza" : "Fotoğraf";
        if (await Dialogs.ShowMessageBoxAsync($"{what} kaldırılsın mı?", $"{what} görevden silinecek. Bu işlem geri alınamaz.",
                "Kaldır", cancelText: "Vazgeç") != true) return;
        await OnRemove.InvokeAsync(a);
    }
}
