@{ var look = Ui.StatusLook(Status); }
<span class="wfm-status @Class" style="background:@look.Hex;color:@look.Fg">
    <span class="material-icons" aria-hidden="true">@look.Icon</span>@Ui.Status(Status)
</span>

@code {
    [Parameter, EditorRequired] public WorkTaskStatus Status { get; set; }
    [Parameter] public string? Class { get; set; }
}
