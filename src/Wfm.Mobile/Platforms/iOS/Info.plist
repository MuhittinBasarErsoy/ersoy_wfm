<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <key>UIDeviceFamily</key>
    <array>
        <integer>1</integer>
        <integer>2</integer>
    </array>
    <key>UIRequiredDeviceCapabilities</key>
    <array>
        <string>arm64</string>
    </array>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>Görev konumuna yol tarifi ve teslim noktasının doğrulanması için konumunuz kullanılır.</string>
    <key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
    <string>Mesaideyken konumunuz, uygulama arka plandayken de yöneticinizle paylaşılır.</string>
    <key>NSCameraUsageDescription</key>
    <string>Teslim ve iş kanıtı fotoğrafı çekmek için kamera kullanılır.</string>
    <key>NSPhotoLibraryUsageDescription</key>
    <string>Galeriden kanıt fotoğrafı seçmek için kullanılır.</string>
    <key>UIBackgroundModes</key>
    <array>
        <string>location</string>
        <string>fetch</string>
    </array>
    <key>NSAppTransportSecurity</key>
    <dict>
        <!-- Geliştirmede yerel http API'ye erişim; üretimde HTTPS kullanın. -->
        <key>NSAllowsLocalNetworking</key>
        <true/>
    </dict>
    <key>XSAppIconAssets</key>
    <string>Assets.xcassets/appicon.appiconset</string>
</dict>
</plist>
