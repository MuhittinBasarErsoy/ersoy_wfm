<script type="module" src="@Assets["Components/Layout/ReconnectModal.razor.js"]"></script>

@* Sunucu bağlantısı koptuğunda gösterilir. Oturum geri gelemezse sayfa kendiliğinden yenilenir (ReconnectModal.razor.js). *@
<dialog id="components-reconnect-modal" data-nosnippet aria-live="polite">
    <div class="components-reconnect-container">
        <div class="components-rejoining-animation" aria-hidden="true">
            <div></div>
            <div></div>
        </div>
        <p class="components-reconnect-first-attempt-visible">
            Bağlantı koptu, yeniden bağlanılıyor…
        </p>
        <p class="components-reconnect-repeated-attempt-visible">
            Sunucuya ulaşılamıyor. <span id="components-seconds-to-next-attempt"></span> saniye içinde yeniden denenecek.
        </p>
        <p class="components-reconnect-failed-visible">
            Sunucuya ulaşılamıyor. Bağlantı gelince kendiliğinden devam edilecek.
        </p>
        <button id="components-reconnect-button" class="components-reconnect-failed-visible">
            Şimdi dene
        </button>
        <p class="components-pause-visible">
            Oturum kaldığı yerden sürdürülüyor…
        </p>
        <p class="components-resume-failed-visible">
            Oturum sürdürülemedi, sayfa yenileniyor…
        </p>
        <button id="components-resume-button" class="components-resume-failed-visible">
            Sayfayı yenile
        </button>
    </div>
</dialog>
