# Kopyalayın: cp .env.example .env  — sonra değerleri doldurun. .env git'e girmez.

# Tailscale: admin panel → Settings → Keys → "Generate auth key" (tek kullanımlık yeterli değil,
# iki düğüm için "Reusable" seçin). Tailnet adı: admin panel → DNS sayfasında görünür.
TS_AUTHKEY=
TS_TAILNET=tailXXXX.ts.net
TS_WEB_HOSTNAME=wfm
TS_API_HOSTNAME=wfm-api

# SQL Server sa parolası: en az 8 karakter, büyük/küçük harf, rakam ve sembol içermeli
DB_PASSWORD=

# JWT imza anahtarı, en az 32 karakter. Üretmek için: openssl rand -base64 48
JWT_KEY=

# admin@wfm.local (sistem yöneticisi) parolası — yalnızca ilk kurulumda kullanılır.
# En az 6 karakter, büyük/küçük harf, rakam ve sembol.
ADMIN_PASSWORD=

# Demo şirketler ve hesaplar (parola Demo123!). Herkese açık sunucuda sunum sonrası false yapın.
DEMO_DATA=false
